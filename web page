            if ($result) {
                foreach ($result as $col) {
                    $id = $col["id"];
                    $name = $col["name"];
                    $email = $col["email"];
                    $birthday = $col["birthday"];
                    $address = $col["address"];
                    $gender = $col["gender"];

                    echo '<tr>
