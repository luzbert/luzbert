<?php

include 'ConnectionPath.php';

$userid = $_GET['updatebyid'];

$sql = "SELECT name, email, birthday, address, gender FROM bayas_table WHERE ID = :id";
$statement = $con->prepare($sql);
$statement->bindParam(':id', $userid, PDO::PARAM_INT);
$statement->execute();
$result = $statement->fetch(PDO::FETCH_ASSOC);

if ($result) {
    $original_name = $result['name'];
    $original_email = $result['email'];
    $original_birthday = $result['birthday'];
    $original_address = $result['address'];
    $original_gender = $result['gender'];
}

if (isset($_POST['updateButton'])) {
    $name = $_POST['name'];
    $email = $_POST['email'];
    $birthday = $_POST['birthday'];
    $address = $_POST['address'];
    $gender = $_POST['gender'];

    $sql_update = "UPDATE `bayas_table` SET `name` = :name, `email` = :email, `birthday` = :birthday, `address` = :address, `gender` = :gender WHERE `ID` = :id";
    $update_statement = $con->prepare($sql_update);
    $update_statement->bindParam(':name', $name);
    $update_statement->bindParam(':email', $email);
    $update_statement->bindParam(':birthday', $birthday);
    $update_statement->bindParam(':address', $address);
    $update_statement->bindParam(':gender', $gender);
    $update_statement->bindParam(':id', $userid, PDO::PARAM_INT);
    $update_result = $update_statement->execute();

    if ($update_result) {
        header('location: Webpage.php');
        exit;
    } else {
        echo '<script> alert("Update Not Successful"); </script>';
    }
}
?>

